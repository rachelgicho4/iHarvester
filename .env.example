# Required
BOT_TOKEN=
OWNER_USER_IDS=123456789
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=telegram_campaign_orchestrator

# webhook for Koyeb/Render/Railway/Heroku; polling is convenient for a VPS/local run
RUN_MODE=polling
PUBLIC_BASE_URL=
WEBHOOK_PATH_SECRET=
WEBHOOK_SECRET_TOKEN=
# Optional primary media-kit contact, for example iamskyking2. Child clones
# intentionally use their own first authorised owner instead.
PUBLIC_CONTACT_USERNAME=

# Required only when you enable owner-created tenant clones. Generate once with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Do not change it while clones exist: it encrypts their bot tokens at rest.
CLONE_TOKEN_ENCRYPTION_KEY=
CLONE_DATABASE_PREFIX=iharvester

# Primary iHarvester only. These are Telegram bot usernames, not tokens. The
# authorised-owner fleet worker on the private VPS grants this approved list
# post/edit rights to one selected iHarvester-admin channel at a time.
BOT_FLEET_USERNAMES=HD10STORE111BOT,HD10_22SHAREBOT,HD10REBOOTBOT,HD10SHARE222222BOT,HD10SHARE3333BOT,hd10share555bot,iBoxTV66666bot,HD10SHARE7777BOT,HD10SHARE8888888BOT,hd10share999bot,HD10SHARE1000BOT,HoDragonsBot,hd10share13bot,ibox3bot,whatdoyouwantrobot

# Conservative free-broadcast defaults
BROADCAST_SEND_RPS=20
BROADCAST_GLOBAL_API_RPS=25
BROADCAST_WORKERS=20
DELIVERY_LEASE_SECONDS=90
SCHEDULER_LEASE_SECONDS=30
SCHEDULER_TICK_SECONDS=2
TELEGRAM_REQUEST_TIMEOUT_SECONDS=20
MAX_TRANSIENT_ATTEMPTS=3
DEFAULT_TIMEZONE=Africa/Nairobi
ALLOW_PAID_BROADCAST=false
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_EVERY_NEW_CHANNELS=100
AUTO_BACKUP_INTERVAL_HOURS=168
LOG_LEVEL=INFO
LIVE_TEST_ENABLED=false
LIVE_TEST_CHANNEL_IDS=
